---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
import { localizeHref, locales as allLocales, baseLocale, getTextDirection } from "../paraglide/runtime.js";
import { m } from "../paraglide/messages.js";

export interface Props {
  title: string;
  description?: string;
  /** Extra JSON-LD for this page, merged alongside the site-wide block. */
  schema?: Record<string, unknown>;
  locale: string;
  canonicalPath?: string;
  robots?: string;
}

const {
  title,
  description = m.layout_meta_description(),
  schema,
  locale,
  canonicalPath: canonicalPathOverride,
  robots,
} = Astro.props;

const canonicalPath = canonicalPathOverride ?? Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, Astro.site);
const localizedURLs = allLocales.map((loc) => ({
  locale: loc,
  url: new URL(localizeHref(canonicalPath, { locale: loc }), Astro.site),
}));
const defaultURL = new URL(localizeHref(canonicalPath, { locale: baseLocale }), Astro.site);
const ogImageURL = new URL("/og-image.png", Astro.site);

const ogLocales: Record<string, string> = {
  en: "en_US",
  nl: "nl_NL",
  de: "de_DE",
  es: "es_ES",
  hr: "hr_HR",
  it: "it_IT",
  fr: "fr_FR",
};
---

<!doctype html>
<html lang={locale} dir={getTextDirection()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" sizes="any" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Hreflang -->
    {
      localizedURLs.map(({ locale: loc, url }) => (
        <link
          rel="alternate"
          hreflang={loc}
          href={url}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={defaultURL}
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content="Transcribr" />
    <meta property="og:locale" content={ogLocales[locale] || "en_US"} />
    {allLocales.filter((loc) => loc !== locale).map((loc) => (
      <meta property="og:locale:alternate" content={ogLocales[loc]} />
    ))}
    <meta name="theme-color" content="#5B4FE8" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="twitter:site" content="@transcribr" />
    <meta name="twitter:creator" content="@transcribr" />
    <meta name="twitter:domain" content="transcribr.org" />
    <meta name="twitter:url" content={canonicalURL} />

    <title>{title}</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Transcribr",
      "operatingSystem": "Web, iOS",
      "applicationCategory": "BusinessApplication",
      "offers": [
        { "@type": "Offer", "name": m.pricing_plan_free_name(), "description": m.store_free_note(), "price": "0", "priceCurrency": "USD" },
        { "@type": "Offer", "name": m.pricing_credits_pack_3(), "price": "4.99", "priceCurrency": "USD" },
        { "@type": "Offer", "name": m.pricing_credits_pack_10(), "price": "9.99", "priceCurrency": "USD" },
        { "@type": "Offer", "name": m.pricing_credits_pack_25(), "price": "21.99", "priceCurrency": "USD" },
        { "@type": "Offer", "name": m.pricing_credits_pack_60(), "price": "44.99", "priceCurrency": "USD" },
        { "@type": "Offer", "name": m.pricing_plan_weekly_name(), "price": "3.00", "priceCurrency": "USD" },
        { "@type": "Offer", "name": m.pricing_plan_premium_name(), "price": "10.00", "priceCurrency": "USD" }
      ],
      "description": description,
      "url": canonicalURL.toString(),
      "featureList": [
        "10 free transcription minutes a day, on any tier",
        "Credit packs with no subscription, each lasting 12 months",
        "Audio and video transcription",
        "Speaker identification",
        "Summaries and insights",
        "Private in-browser audio conversion and codec-preserving compression",
        "Large file conversion streamed straight to disk instead of held in memory",
        "Estimated output size and audio preview before downloading a conversion",
        "Persistent local batch conversion and clip extraction",
        "On-device live notes with optional local audio recording",
        "Local notes exported to Markdown, DOCX, PDF or plain text",
        "One-step handoff from a local recording to full cloud transcription",
        "Pro Private Studio for local subtitle editing, waveform clipping, and sensitive-data redaction",
        "Subtitle editor with undo, redo and timing validation before export",
        "Reviewable redaction that accepts or rejects each detected match",
        "Encrypted note and recording backups to a local file or to opt-in cloud storage",
        "Client-side AES-GCM encryption with a passphrase that never leaves the device",
        "Export to SRT, VTT, PDF, TXT and CSV"
      ]
    })} />

    <!-- Page-specific structured data, e.g. FAQPage, which is what earns the
         expandable answers in search results. -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Theme flash prevention & JS detection -->
    <script is:inline>
      (function() {
        document.documentElement.classList.add("js");
        var t = localStorage.getItem("theme");
        if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground"
    >
      {m.layout_skip_to_content()}
    </a>
    <Header locale={locale} />
    <div id="main-content">
      <slot />
    </div>
    <Footer />

    <script>
      import { initAnalytics, track, Events } from "../lib/analytics";

      /**
       * Analytics bootstrap and the site-wide click instrumentation.
       *
       * `initAnalytics` starts Firebase only if consent already exists; a first
       * visit records nothing until the banner is answered, at which point the
       * buffered page view is sent along with it.
       *
       * Clicks are handled by one delegated listener rather than by a listener
       * per element. The CTAs are spread over eight components and rendered
       * twice on some pages (desktop and mobile), so per-element wiring would
       * mean eight places to forget.
       */
      initAnalytics();

      // No manual page_view here. Firebase Analytics sends one automatically on
      // initialisation, and every page on this site is a full document load, so
      // a second call produced two hits for one visit — verified against the
      // network log rather than assumed. Path, referrer and language are all
      // dimensions GA4 already collects by itself; `surface` and `locale` are
      // attached as user properties in analytics.ts and therefore ride along on
      // the automatic event too.

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        const link = target?.closest?.("a");
        if (!link) return;

        const href = link.getAttribute("href") ?? "";
        const placement = link.dataset.analyticsPlacement ?? "unknown";

        // The app itself — the only conversion this site has.
        if (href.includes("app.transcribr.org")) {
          track(Events.CTA_CLICKED, {
            destination: href.includes("/auth") ? "signup" : "app",
            placement,
            plan: link.dataset.analyticsPlan,
          });
          return;
        }

        if (href.includes("apps.apple.com")) {
          track(Events.APP_STORE_CLICKED, { store: "app_store", placement });
          return;
        }

        if (href.startsWith("mailto:")) {
          track(Events.OUTBOUND_CLICKED, { kind: "email", placement });
          return;
        }

        // Anchors to the pricing block, wherever on the site they are.
        if (href.includes("#pricing")) {
          track(Events.PRICING_VIEWED, { placement });
        }
      });

      // The language switcher renders twice per page and its options are plain
      // links, so this is delegated too.
      document.addEventListener("click", (event) => {
        const option = (event.target as HTMLElement | null)?.closest?.(
          "[data-lang-option]",
        ) as HTMLElement | null;
        if (!option) return;
        track(Events.LANGUAGE_CHANGED, {
          to: option.dataset.langOption,
          from: document.documentElement.lang || "en",
        });
      });

      // Uncaught errors on a marketing page are usually a broken bundle on some
      // browser we do not test — worth knowing about, and invisible otherwise.
      window.addEventListener("error", (event) => {
        track(Events.CLIENT_ERROR, {
          error_message: String(event.message ?? "").slice(0, 90),
          page_path: window.location.pathname,
        });
      });
    </script>

    <script>
      const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("animate-fade-up");
          }
        });
      }, observerOptions);

      document.addEventListener("DOMContentLoaded", () => {
        const elements = document.querySelectorAll("[data-animate]");
        elements.forEach((el) => observer.observe(el));
      });
    </script>
  </body>
</html>
