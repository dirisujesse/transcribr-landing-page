---
import { m } from "../paraglide/messages.js";

const appUrl = "https://app.transcribr.org/auth";

const check = `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59Z"/></svg>`;
const cross = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>`;

const plans = [
  {
    name: m.pricing_plan_free_name(),
    price: "$0",
    // No period: the free allowance is counted per day, so "$0/month" read
    // like a monthly plan. The card shows the price alone.
    period: undefined,
    blurb: m.pricing_plan_free_blurb(),
    featured: false,
    cta: m.pricing_plan_free_cta(),
    features: [
      { text: m.pricing_plan_free_feat1(), included: true },
      { text: m.pricing_plan_free_feat2(), included: true },
      { text: m.pricing_plan_free_feat3(), included: true },
      { text: m.pricing_plan_free_feat4(), included: true },
      { text: m.pricing_plan_free_feat5(), included: true },
      { text: m.pricing_plan_free_feat6(), included: true },
      { text: m.pricing_plan_free_feat7(), included: true },
      { text: m.pricing_plan_free_feat8(), included: true },
      { text: m.pricing_plan_free_feat9(), included: false },
    ],
  },
  {
    name: m.pricing_plan_weekly_name(),
    price: m.pricing_plan_weekly_price(),
    period: m.pricing_plan_weekly_period(),
    blurb: m.pricing_plan_weekly_blurb(),
    featured: false,
    cta: m.pricing_plan_weekly_cta(),
    features: [
      { text: m.pricing_plan_weekly_feat1(), included: true },
      { text: m.pricing_plan_weekly_feat2(), included: true },
      { text: m.pricing_plan_weekly_feat3(), included: true },
      { text: m.pricing_plan_weekly_feat4(), included: true },
      { text: m.pricing_plan_weekly_feat5(), included: true },
      { text: m.pricing_plan_weekly_feat6(), included: true },
      { text: m.pricing_plan_weekly_feat7(), included: true },
      { text: m.pricing_plan_weekly_feat8(), included: true },
    ],
  },
  {
    name: m.pricing_plan_premium_name(),
    price: m.pricing_plan_premium_price(),
    period: m.pricing_plan_premium_period(),
    blurb: m.pricing_plan_premium_blurb(),
    featured: true,
    badge: m.pricing_plan_premium_badge(),
    cta: m.pricing_plan_premium_cta(),
    features: [
      { text: m.pricing_plan_premium_feat1(), included: true },
      { text: m.pricing_plan_premium_feat2(), included: true },
      { text: m.pricing_plan_premium_feat3(), included: true },
      { text: m.pricing_plan_premium_feat4(), included: true },
      { text: m.pricing_plan_premium_feat5(), included: true },
      { text: m.pricing_plan_premium_feat6(), included: true },
      { text: m.pricing_plan_premium_feat7(), included: true },
      { text: m.pricing_plan_premium_feat8(), included: true },
      { text: m.pricing_plan_premium_feat9(), included: true },
      { text: m.pricing_plan_premium_feat10(), included: true },
    ],
  },
];
---

<section id="pricing" class="section bg-surface">
  <div class="container-page">
    <div class="mx-auto mb-14 max-w-2xl text-center" data-animate>
      <p
        class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary"
      >
        {m.pricing_label()}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-foreground md:text-4xl">
        {m.pricing_heading()}
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        {m.pricing_subtext()}
      </p>
    </div>

    <div class="mx-auto grid max-w-5xl gap-6 md:grid-cols-3 md:items-stretch">
      {
        plans.map((plan) => (
          <div
            class:list={[
              "relative flex h-full flex-col rounded-2xl border p-6 md:p-8",
              plan.featured
                ? "border-primary bg-primary text-primary-foreground shadow-xl shadow-primary/20 md:scale-[1.02] md:z-10"
                : "border-border bg-white shadow-sm",
            ]}
            data-animate
          >
            {plan.badge && (
              <span class="absolute right-4 top-4 rounded-full bg-white px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-primary">
                {plan.badge}
              </span>
            )}

            <div class="mb-6">
              <h3
                class:list={[
                  "text-xl font-bold",
                  plan.featured ? "text-white" : "text-foreground",
                ]}
              >
                {plan.name}
              </h3>
              <div class="mt-3 flex items-baseline gap-1">
                <span class="text-4xl font-bold tracking-tight">
                  {plan.price}
                </span>
                {plan.period && (
                  <span
                    class:list={[
                      "text-sm font-medium",
                      plan.featured ? "text-white/70" : "text-muted-foreground",
                    ]}
                  >
                    {plan.period}
                  </span>
                )}
              </div>
              <p
                class:list={[
                  "mt-2 text-sm",
                  plan.featured ? "text-white/75" : "text-muted-foreground",
                ]}
              >
                {plan.blurb}
              </p>
            </div>

            <ul class="mb-8 flex-1 space-y-3">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2.5 text-sm">
                  <span
                    class:list={[
                      "mt-0.5 shrink-0",
                      f.included
                        ? plan.featured
                          ? "text-white"
                          : "text-primary"
                        : plan.featured
                          ? "text-white/40"
                          : "text-muted-foreground",
                    ]}
                    set:html={f.included ? check : cross}
                  />
                  <span
                    class:list={[
                      !f.included &&
                        (plan.featured
                          ? "text-white/50"
                          : "text-muted-foreground"),
                    ]}
                  >
                    {f.text}
                  </span>
                </li>
              ))}
            </ul>

            <a
              href={appUrl}
              target="_blank"
              rel="noopener noreferrer"
              class:list={[
                "inline-flex w-full items-center justify-center rounded-full px-5 py-3 text-sm font-semibold transition-colors",
                plan.featured
                  ? "bg-white text-primary hover:bg-white/90"
                  : plan.name === m.pricing_plan_weekly_name()
                    ? "bg-primary-soft text-primary hover:bg-primary/15"
                    : "bg-surface text-foreground hover:bg-border/60",
              ]}
            
            data-analytics-placement="pricing"
            data-analytics-plan={plan.name}>
              {plan.cta}
            </a>
          </div>
        ))
      }
    </div>

	<p class="mx-auto mt-8 max-w-2xl text-center text-sm text-muted-foreground">
	  {m.pricing_reassurance()}
	</p>
	<p class="mx-auto mt-2 max-w-2xl text-center text-xs text-muted-foreground">
	  {m.pricing_fair_use()}
	</p>

    <!--
      Credits get a band of their own for the same reason Feeds does: a pack is
      not a plan. It is bought once, never renews, and is spent only after the
      day's free minutes are gone. The prices are copied by hand, as the plan
      and Feeds prices are, so keep them in step with the packs Stripe sells.
    -->
    <div
      class="mx-auto mt-14 max-w-5xl overflow-hidden rounded-3xl border border-border bg-background"
      data-animate
    >
      <div class="grid gap-8 p-8 md:grid-cols-2 md:items-center md:p-10">
        <div>
          <p
            class="mb-3 inline-block rounded-full bg-primary-soft px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary"
          >
            {m.pricing_credits_label()}
          </p>
          <h3 class="text-2xl font-bold tracking-tight text-foreground">
            {m.pricing_credits_heading()}
          </h3>
          <p class="mt-3 text-muted-foreground">{m.pricing_credits_blurb()}</p>

          <p
            class="mb-3 mt-6 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
          >
            {m.pricing_credits_rate_label()}
          </p>
          <dl class="grid grid-cols-3 gap-3">
            {
              [
                [m.pricing_credits_tier_premium(), m.pricing_credits_hours_1()],
                [m.pricing_credits_tier_standard(), m.pricing_credits_hours_2()],
                [m.pricing_credits_tier_quick(), m.pricing_credits_hours_4()],
              ].map(([tier, hours]) => (
                <div class="rounded-2xl bg-surface p-4 text-center">
                  <dt class="text-xs text-muted-foreground">{tier}</dt>
                  <dd class="mt-1 text-lg font-bold text-foreground">{hours}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-3 text-xs text-muted-foreground">
            {m.pricing_credits_rate_note()}
          </p>
          <p class="mt-4 text-sm text-muted-foreground">
            {m.pricing_credits_note()}
          </p>
        </div>

        <div class="rounded-2xl bg-surface p-6">
          <span class="text-4xl font-bold text-foreground"
            >{m.pricing_credits_price()}</span
          >
          <p class="mt-2 text-sm text-muted-foreground">
            {m.pricing_credits_tagline()}
          </p>

          <div class="mt-6 border-t border-border pt-5">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              {m.pricing_credits_packs_label()}
            </p>
            <dl class="space-y-2">
              {
                [
                  [
                    m.pricing_credits_pack_3(),
                    m.pricing_credits_pack_3_price(),
                    m.pricing_credits_pack_3_each(),
                  ],
                  [
                    m.pricing_credits_pack_10(),
                    m.pricing_credits_pack_10_price(),
                    m.pricing_credits_pack_10_each(),
                  ],
                  [
                    m.pricing_credits_pack_25(),
                    m.pricing_credits_pack_25_price(),
                    m.pricing_credits_pack_25_each(),
                  ],
                  [
                    m.pricing_credits_pack_60(),
                    m.pricing_credits_pack_60_price(),
                    m.pricing_credits_pack_60_each(),
                  ],
                ].map(([credits, price, each]) => (
                  <div class="flex items-baseline justify-between gap-4 text-sm">
                    <dt class="text-muted-foreground">{credits}</dt>
                    <dd class="text-right">
                      <span class="font-semibold text-foreground">{price}</span>
                      <span class="ml-2 text-xs text-muted-foreground">
                        {each}
                      </span>
                    </dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <a
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary/90"
            data-analytics-placement="pricing"
            data-analytics-plan="credits"
          >
            {m.pricing_credits_cta()}
          </a>
        </div>
      </div>
    </div>

    <!--
      Its own band rather than a fourth card in the grid above. Feeds is sold
      separately from any plan: it needs no plan to go with it, and no plan
      includes it. It is priced by the hours of audio a month rather than as
      unlimited use, so a fourth card would invite a comparison with plans it
      neither replaces nor extends.
    -->
    <div
      class="mx-auto mt-14 max-w-5xl overflow-hidden rounded-3xl border border-border bg-background"
      data-animate
    >
      <div class="grid gap-8 p-8 md:grid-cols-2 md:items-center md:p-10">
        <div>
          <div class="mb-3 flex items-center gap-2">
            <p
              class="inline-block rounded-full bg-primary-soft px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary"
            >
              {m.pricing_addon_label()}
            </p>
            <p
              class="inline-block rounded-full border border-border px-3 py-1 text-xs font-semibold uppercase tracking-wider text-muted-foreground"
            >
              {m.pricing_addon_beta()}
            </p>
          </div>
          <h3 class="text-2xl font-bold tracking-tight text-foreground">
            {m.pricing_addon_heading()}
          </h3>
          <p class="mt-3 text-muted-foreground">{m.pricing_addon_blurb()}</p>
          <p class="mt-4 text-sm text-muted-foreground">
            {m.pricing_addon_note()}
          </p>
        </div>

        <div class="rounded-2xl bg-surface p-6">
          <div class="flex items-baseline gap-1">
            <span class="text-4xl font-bold text-foreground"
              >{m.pricing_addon_price()}</span
            >
            <span class="text-muted-foreground">{m.pricing_addon_period()}</span
            >
          </div>

          <ul class="mt-5 space-y-3">
            {
              [
                m.pricing_addon_feat1(),
                m.pricing_addon_feat2(),
                m.pricing_addon_feat3(),
                m.pricing_addon_feat4(),
              ].map((text) => (
                <li class="flex items-start gap-3 text-sm text-foreground">
                  <span class="mt-0.5 shrink-0 text-primary" set:html={check} />
                  <span>{text}</span>
                </li>
              ))
            }
          </ul>

          <!--
            Three worked examples rather than the raw bands. "$1.50/h for the
            first ten, then $1, then $0.75" is accurate and no one reads it;
            what a buyer wants is what their number costs.
          -->
          <div class="mt-6 border-t border-border pt-5">
            <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
              {m.pricing_addon_tiers_label()}
            </p>
            <dl class="space-y-2">
              {
                [
                  [m.pricing_addon_tier_10(), m.pricing_addon_tier_10_price()],
                  [m.pricing_addon_tier_40(), m.pricing_addon_tier_40_price()],
                  [
                    m.pricing_addon_tier_100(),
                    m.pricing_addon_tier_100_price(),
                  ],
                ].map(([hours, price]) => (
                  <div class="flex items-baseline justify-between text-sm">
                    <dt class="text-muted-foreground">{hours}</dt>
                    <dd class="font-semibold text-foreground">{price}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="mt-3 text-xs text-muted-foreground">
              {m.pricing_addon_tier_more()}
            </p>
          </div>

          <a
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex w-full items-center justify-center rounded-full bg-primary px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-primary/90"
            data-analytics-placement="pricing"
            data-analytics-plan="feeds-addon"
          >
            {m.pricing_addon_cta()}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
