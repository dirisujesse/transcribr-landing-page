---
import { m } from "../paraglide/messages.js";

/**
 * A working converter on the marketing page.
 *
 * The claim above this section is that conversion happens in the browser and
 * nothing is uploaded. This is the proof: a real conversion, no account, no
 * network call. It is also a demo a competitor with a server-side pipeline
 * cannot copy without building the same thing.
 *
 * mediabunny is ~640KB, far too much to load with the page, so it is imported
 * only once someone actually picks a file. Until then this costs a few hundred
 * bytes of markup.
 */
---

<section class="section" id="try">
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center" data-animate>
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">
        {m.demo_eyebrow()}
      </p>
      <h2 class="text-3xl font-bold tracking-tight text-balance text-foreground md:text-4xl">
        {m.demo_heading()}
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        {m.demo_body()}
      </p>
    </div>

    <div
      class="mx-auto mt-10 max-w-xl rounded-3xl border border-border bg-white p-6 shadow-sm"
      data-animate
      data-demo
      data-msg-failed={m.demo_failed()}
      data-msg-noaudio={m.demo_noaudio()}
      data-msg-badformat={m.demo_badformat()}
      data-msg-toolarge={m.demo_toolarge()}
      data-msg-pick={m.demo_pick()}
      data-msg-hint={m.demo_hint()}
      data-msg-sample-loading={m.demo_sample_loading()}
      data-sample-src="/samples/meeting-clip.wav"
      data-sample-name={m.demo_sample_name()}
    >
      <!-- Hidden until the script confirms the browser can encode. Without JS,
           or without WebCodecs, the section simply shows the fallback note. -->
      <div data-demo-unsupported hidden>
        <p class="text-center text-sm text-muted-foreground">
          {m.demo_unsupported()}
        </p>
      </div>

      <div data-demo-ui hidden>
        <button
          type="button"
          data-demo-pick
          class="flex w-full flex-col items-center gap-2 rounded-2xl border border-dashed border-border p-8 text-center transition hover:border-primary"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="text-muted-foreground" aria-hidden="true">
            <path d="M12 3v12M7 8l5-5 5 5M5 21h14"></path>
          </svg>
          <span class="font-semibold text-foreground" data-demo-name>{m.demo_pick()}</span>
          <span class="text-sm text-muted-foreground" data-demo-size>{m.demo_hint()}</span>
        </button>
        <input type="file" accept="audio/*,video/*" class="hidden" data-demo-input />

        <!-- Most visitors do not have a media file to hand while reading a
             marketing page. Without this, the demo asks for effort before it
             has shown anything. -->
        <button
          type="button"
          data-demo-sample
          class="mt-3 w-full text-center text-sm text-primary underline-offset-4 hover:underline"
        >
          {m.demo_sample()}
        </button>

        <div class="mt-4 flex flex-wrap items-center justify-center gap-2" data-demo-formats></div>

        <button
          type="button"
          data-demo-go
          class="btn-primary mt-4 w-full justify-center disabled:cursor-not-allowed disabled:opacity-50"
          disabled
        >
          {m.demo_go()}
        </button>

        <div class="mt-4 hidden" data-demo-progress-wrap>
          <div class="h-2 w-full overflow-hidden rounded-full bg-muted">
            <div class="h-full w-0 rounded-full bg-primary transition-all" data-demo-progress></div>
          </div>
          <p class="mt-2 text-center text-sm text-muted-foreground">{m.demo_working()}</p>
          <!-- A conversion on the main thread can take a while on a long file,
               and a visitor who only wanted to see it work should never be stuck
               watching it finish. -->
          <button
            type="button"
            data-demo-cancel
            class="mt-2 w-full text-center text-sm text-muted-foreground underline-offset-4 hover:underline disabled:opacity-50"
          >
            {m.demo_cancel()}
          </button>
        </div>

        <div class="mt-4 hidden rounded-2xl border border-border bg-muted/30 p-4 text-center" data-demo-result>
          <p class="text-sm text-foreground" data-demo-result-text></p>
          <p class="mt-1 text-xs text-primary">{m.demo_privacy()}</p>
          <div class="mt-3 flex flex-wrap justify-center gap-2">
            <button type="button" class="btn-primary" data-demo-download>{m.demo_download()}</button>
            <button type="button" class="btn-secondary" data-demo-reset>{m.demo_again()}</button>
          </div>
        </div>

        <p class="mt-3 hidden text-center text-sm text-destructive" data-demo-error></p>

        <!-- Kept apart from the error line: a file this demo declines to take on
             is not a failure the visitor caused, and red would read as one. -->
        <p class="mt-3 hidden text-center text-sm text-muted-foreground" data-demo-note></p>
      </div>
    </div>
  </div>
</section>

<script>
  type Target = {
    id: string;
    label: string;
    ext: string;
    mime: string;
    codec: string;
    make: (lib: any) => any;
  };

  const TARGETS: Target[] = [
    { id: "mp3", label: "MP3", ext: "mp3", mime: "audio/mpeg", codec: "mp3", make: (l) => new l.Mp3OutputFormat() },
    { id: "m4a", label: "M4A", ext: "aac", mime: "audio/aac", codec: "aac", make: (l) => new l.AdtsOutputFormat() },
    { id: "ogg", label: "OGG", ext: "ogg", mime: "audio/ogg", codec: "opus", make: (l) => new l.OggOutputFormat() },
    { id: "wav", label: "WAV", ext: "wav", mime: "audio/wav", codec: "pcm-s16", make: (l) => new l.WavOutputFormat() },
  ];

  /** The MPEG-1 Layer III rates — the only ones lamejs encodes reliably. */
  const MP3_SAMPLE_RATES = [32000, 44100, 48000];

  /**
   * The rate to resample to so MP3 encoding can proceed, or undefined when the
   * source rate is already encodable.
   *
   * MP3 is the default target here, so without this a 16kHz source — phone voice
   * memos, and Transcribr's own compressed output — makes the conversion invalid
   * and the visitor meets a generic failure on the format they did not choose.
   */
  function mp3CompatibleSampleRate(sourceRate: number | undefined): number | undefined {
    if (!sourceRate || MP3_SAMPLE_RATES.includes(sourceRate)) return undefined;
    // Upward, so no fidelity is lost: 8–32kHz voice lands on 32kHz, everything
    // else on the universal 44.1kHz.
    return sourceRate <= 32000 ? 32000 : 44100;
  }

  /**
   * The largest input this demo will take on.
   *
   * Everything here runs on the main thread into a BufferTarget, so the source
   * and the finished file both sit in the tab's memory at once. Past roughly
   * 200MB that costs a mid-range phone the tab — a worse outcome on a marketing
   * page than declining politely. The app itself uses a worker and streams to
   * disk, so it has no such ceiling.
   */
  const MAX_INPUT_BYTES = 200 * 1024 * 1024;

  /**
   * How long the MP3 encoder may hold the main thread before handing it back.
   *
   * lamejs is synchronous with no yield points, so encoding blocked the thread
   * start to finish: no frames painted, and the progress bar sat still and then
   * jumped to done — on the one demo meant to look effortless. Roughly one frame
   * at 60Hz: long enough that yielding costs almost nothing, short enough that
   * the browser always gets a chance to paint.
   */
  const YIELD_EVERY_MS = 12;

  function now(): number {
    return typeof performance !== "undefined" ? performance.now() : Date.now();
  }

  /**
   * Returns control to the browser so it can paint. `scheduler.yield` resumes
   * sooner and at higher priority than a timer where it exists; setTimeout is
   * the fallback everywhere else.
   */
  function yieldToBrowser(): Promise<void> {
    const scheduler = (globalThis as any).scheduler;
    if (typeof scheduler?.yield === "function") return scheduler.yield();
    return new Promise((resolve) => setTimeout(resolve, 0));
  }

  function humanSize(bytes: number): string {
    if (!bytes) return "0 KB";
    const units = ["B", "KB", "MB", "GB"];
    const i = Math.floor(Math.log(bytes) / Math.log(1024));
    return `${(bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 1)} ${units[i]}`;
  }

  const root = document.querySelector<HTMLElement>("[data-demo]");
  if (root) {
    const ui = root.querySelector<HTMLElement>("[data-demo-ui]")!;
    const unsupported = root.querySelector<HTMLElement>("[data-demo-unsupported]")!;
    const input = root.querySelector<HTMLInputElement>("[data-demo-input]")!;
    const pick = root.querySelector<HTMLButtonElement>("[data-demo-pick]")!;
    const nameEl = root.querySelector<HTMLElement>("[data-demo-name]")!;
    const sizeEl = root.querySelector<HTMLElement>("[data-demo-size]")!;
    const formatsEl = root.querySelector<HTMLElement>("[data-demo-formats]")!;
    const goBtn = root.querySelector<HTMLButtonElement>("[data-demo-go]")!;
    const progressWrap = root.querySelector<HTMLElement>("[data-demo-progress-wrap]")!;
    const progressBar = root.querySelector<HTMLElement>("[data-demo-progress]")!;
    const resultEl = root.querySelector<HTMLElement>("[data-demo-result]")!;
    const resultText = root.querySelector<HTMLElement>("[data-demo-result-text]")!;
    const downloadBtn = root.querySelector<HTMLButtonElement>("[data-demo-download]")!;
    const resetBtn = root.querySelector<HTMLButtonElement>("[data-demo-reset]")!;
    const cancelBtn = root.querySelector<HTMLButtonElement>("[data-demo-cancel]")!;
    const errorEl = root.querySelector<HTMLElement>("[data-demo-error]")!;
    const noteEl = root.querySelector<HTMLElement>("[data-demo-note]")!;

    let lib: any = null;
    let file: File | null = null;
    let chosen = TARGETS[0];
    let output: { blob: Blob; name: string } | null = null;
    let available: Target[] = [];
    let running: any = null;
    let canceled = false;

    const strings = {
      failed: root.dataset.msgFailed ?? "That file could not be converted.",
      noAudio: root.dataset.msgNoaudio ?? "That file has no audio track.",
      badFormat: root.dataset.msgBadformat ?? "That format did not work for this file. Try another one.",
      tooLarge: root.dataset.msgToolarge ?? "That file is over 200 MB. The full app handles sizes like that.",
      pick: root.dataset.msgPick ?? "Choose a file",
      hint: root.dataset.msgHint ?? "Audio or video · processed on this device",
      sampleLoading: root.dataset.msgSampleLoading ?? "Loading sample…",
    };

    /**
     * Loads the media library, and teaches it MP3.
     *
     * No browser exposes an MP3 encoder through WebCodecs, but MP3 is the
     * format visitors expect a converter to produce. mediabunny's
     * registerEncoder hook lets a JavaScript encoder fill that one gap while
     * the library still handles demuxing, resampling and muxing.
     *
     * Both are loaded on demand — together they dwarf the rest of the page.
     */
    async function load() {
      if (lib) return lib;

      const [media, lame] = await Promise.all([
        import("mediabunny"),
        import("@breezystack/lamejs"),
      ]);

      const SPF = 1152;
      const BLOCK = SPF * 4;

      class LameMp3Encoder extends media.CustomAudioEncoder {
        static supports(codec: string, config: any) {
          return (
            codec === "mp3" &&
            (config.numberOfChannels === 1 || config.numberOfChannels === 2) &&
            MP3_SAMPLE_RATES.includes(config.sampleRate)
          );
        }
        enc: any; left!: Int16Array; right!: Int16Array;
        pending = 0; emitted = 0; carried = 0; lastYield = 0;
        channels = 2; rate = 44100;

        init() {
          this.channels = (this as any).config.numberOfChannels;
          this.rate = (this as any).config.sampleRate;
          const kbps = Math.max(32, Math.round(((this as any).config.bitrate ?? 128000) / 1000));
          this.enc = new lame.Mp3Encoder(this.channels, this.rate, kbps);
          this.left = new Int16Array(BLOCK);
          this.right = new Int16Array(BLOCK);
          this.pending = 0;
          this.emitted = 0;
          this.carried = 0;
          this.lastYield = now();
        }
        async encode(sample: any) {
          if (!this.enc) return;
          const size = sample.allocationSize({ planeIndex: 0, format: "s16" });
          const inter = new Int16Array(new ArrayBuffer(size));
          sample.copyTo(inter, { planeIndex: 0, format: "s16" });
          for (let f = 0; f < sample.numberOfFrames; f++) {
            this.left[this.pending] = inter[f * this.channels] ?? 0;
            if (this.channels === 2) this.right[this.pending] = inter[f * this.channels + 1] ?? 0;
            if (++this.pending === BLOCK) {
              this.drain();
              // Checked per block rather than per frame: the clock read would
              // otherwise cost more than the encoding it interrupts.
              if (now() - this.lastYield >= YIELD_EVERY_MS) {
                await yieldToBrowser();
                this.lastYield = now();
              }
            }
          }
        }
        flush() {
          if (!this.enc) return;
          if (this.pending) this.drain();
          // lamejs holds a final partial frame back until flushed. It covers no
          // input beyond what is already carried, so it adds no duration itself.
          const tail = this.enc.flush();
          if (tail?.length) this.emit(tail, 0);
        }
        close() { this.enc = null; }
        drain() {
          if (!this.enc || !this.pending) return;
          const consumed = this.pending;
          const l = this.left.subarray(0, consumed);
          const data = this.channels === 2
            ? this.enc.encodeBuffer(l, this.right.subarray(0, consumed))
            : this.enc.encodeBuffer(l);
          this.pending = 0;
          // Emit even when lamejs returns nothing this round, so the samples it
          // buffered are still accounted for in the timeline.
          this.emit(data ?? new Uint8Array(0), consumed);
        }
        /**
         * Emits a packet covering the input samples it consumed.
         *
         * Timing comes from samples fed in, never from output size — a count
         * derived from byteLength drifts whenever lamejs's real bitrate differs
         * from the configured one, and the drift lands in the container's
         * duration header.
         *
         * Rounds where lamejs returns nothing carry their samples forward
         * instead of advancing the clock: those samples are still inside the
         * encoder and come out with the next packet, so charging them to a
         * packet that was never written would leave a hole between the packets'
         * accumulated durations and their timestamps.
         */
        emit(data: any, consumed: number) {
          if (!data.byteLength && !consumed) return;
          const bytes = data instanceof Uint8Array
            ? data
            : new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
          if (!bytes.byteLength) {
            this.carried += consumed;
            return;
          }
          const covered = consumed + this.carried;
          const ts = this.emitted / this.rate;
          const dur = covered / this.rate;
          this.emitted += covered;
          this.carried = 0;
          (this as any).onPacket(new media.EncodedPacket(new Uint8Array(bytes), "key", ts, dur));
        }
      }

      media.registerEncoder(LameMp3Encoder as any);
      lib = media;
      return lib;
    }

    function showError(message: string) {
      noteEl.classList.add("hidden");
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    }

    function showNote(message: string) {
      errorEl.classList.add("hidden");
      noteEl.textContent = message;
      noteEl.classList.remove("hidden");
    }

    function clearMessages() {
      errorEl.classList.add("hidden");
      noteEl.classList.add("hidden");
    }

    function renderFormats() {
      formatsEl.innerHTML = "";
      for (const target of available) {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = target.label;
        button.className =
          "rounded-lg border px-3 py-1.5 text-sm transition " +
          (chosen.id === target.id
            ? "border-primary bg-primary/10 text-primary"
            : "border-border text-muted-foreground hover:border-primary/50");
        button.addEventListener("click", () => {
          chosen = target;
          renderFormats();
        });
        formatsEl.appendChild(button);
      }
    }

    async function detect() {
      if (typeof (window as any).AudioEncoder === "undefined") {
        unsupported.hidden = false;
        ui.hidden = true;
        return;
      }

      const l = await load();
      // Probed with a concrete config: an unconfigured probe answers for the
      // library's defaults, which for MP3 says yes regardless of what the
      // registered encoder actually accepts. 44.1kHz stereo is what every
      // source is normalised to below, so it is the honest question to ask.
      const checks = await Promise.all(
        TARGETS.map(async (t) =>
          (await l.canEncodeAudio(t.codec, {
            numberOfChannels: 2,
            sampleRate: 44100,
            ...(t.codec === "pcm-s16" ? {} : { bitrate: 128000 }),
          }))
            ? t
            : null,
        ),
      );
      available = checks.filter(Boolean) as Target[];

      if (!available.length) {
        unsupported.hidden = false;
        ui.hidden = true;
        return;
      }

      chosen = available[0];
      renderFormats();
    }

    // The picker is shown immediately. Detection is what needs the library, and
    // an earlier version gated the whole UI behind the IntersectionObserver —
    // if that never fired the visitor got an empty box with no explanation.
    // Missing WebCodecs is knowable without the library, so that verdict is
    // reached now rather than waiting for a warm-up that may never be wanted.
    const webCodecs = typeof (window as any).AudioEncoder !== "undefined";
    ui.hidden = !webCodecs;
    unsupported.hidden = webCodecs;

    let detecting: Promise<void> | null = null;
    const detectOnce = () =>
      (detecting ??= detect().catch((error) => {
        // A failed import is usually a transient network problem. Forget it so
        // the next click retries instead of replaying the failure forever.
        detecting = null;
        throw error;
      }));

    /**
     * ~700KB of encoder libraries is a bad trade for someone who merely scrolled
     * past on a metered or slow connection — they never asked for a conversion.
     * They still get the libraries the moment they click.
     */
    function warmUpIsWelcome(): boolean {
      const connection = (navigator as any).connection;
      if (!connection) return true;
      if (connection.saveData) return false;
      return !["slow-2g", "2g", "3g"].includes(connection.effectiveType);
    }

    // Warm the library when the section comes into view, so the first click is
    // instant, but never depend on it having happened.
    if (typeof IntersectionObserver !== "undefined" && warmUpIsWelcome()) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          observer.disconnect();
          void detectOnce().catch(() => {});
        },
        { rootMargin: "200px" },
      );
      observer.observe(root);
    }

    pick.addEventListener("click", () => {
      // Synchronously, before anything is awaited: awaiting the dynamic import
      // first spends the user activation on a network fetch, and Safari and some
      // mobile browsers then refuse to open the picker at all. Detection is
      // idempotent and every path that needs it awaits it again.
      input.click();
      void detectOnce().catch(() => {});
    });

    function accept(picked: File, label: string) {
      if (picked.size > MAX_INPUT_BYTES) {
        // Not a failure the visitor caused, and the product being advertised
        // handles this file fine — so this points onward instead of apologising.
        showNote(strings.tooLarge);
        file = null;
        output = null;
        // Cleared so choosing a smaller file, or the same one again, still fires
        // a change event.
        input.value = "";
        goBtn.disabled = true;
        nameEl.textContent = strings.pick;
        sizeEl.textContent = strings.hint;
        resultEl.classList.add("hidden");
        return;
      }

      file = picked;
      output = null;
      nameEl.textContent = label;
      sizeEl.textContent = humanSize(picked.size);
      goBtn.disabled = false;
      resultEl.classList.add("hidden");
      clearMessages();
    }

    input.addEventListener("change", () => {
      const picked = input.files?.[0];
      if (!picked) return;
      accept(picked, picked.name);
    });

    const sampleBtn = root.querySelector<HTMLButtonElement>("[data-demo-sample]");

    sampleBtn?.addEventListener("click", async () => {
      const src = root.dataset.sampleSrc;
      if (!src) return;

      sampleBtn.disabled = true;
      sizeEl.textContent = strings.sampleLoading;

      try {
        await detectOnce();
        const response = await fetch(src);
        const blob = await response.blob();
        const name = root.dataset.sampleName ?? "sample.wav";

        accept(new File([blob], name, { type: "audio/wav" }), name);
      } catch {
        sizeEl.textContent = strings.hint;
        showError(strings.failed);
      } finally {
        sampleBtn.disabled = false;
      }
    });

    cancelBtn.addEventListener("click", () => {
      // Flagged whether or not a conversion object exists yet: the first moments
      // of a run are spent opening the input, and a button that did nothing
      // during them would be a lie.
      canceled = true;
      cancelBtn.disabled = true;
      void running?.cancel();
    });

    goBtn.addEventListener("click", async () => {
      if (!file) return;

      goBtn.disabled = true;
      canceled = false;
      clearMessages();
      resultEl.classList.add("hidden");
      progressWrap.classList.remove("hidden");
      progressBar.style.width = "0%";

      try {
        // The picker may have been used before the warm-up finished, so the
        // library is only guaranteed to be here — and `chosen` only known to be
        // encodable — once detection has resolved.
        await detectOnce();
        const l = await load();
        const input_ = new l.Input({ source: new l.BlobSource(file), formats: l.ALL_FORMATS });

        const track = await input_.getPrimaryAudioTrack();
        if (!track) throw new Error("no-audio");

        // lamejs accepts MPEG-1 rates only, so anything else has to be resampled
        // on the way out or MP3 — the default target — is refused outright.
        const outputSampleRate =
          chosen.codec === "mp3" ? mp3CompatibleSampleRate(track.sampleRate) : undefined;

        const out = new l.Output({ format: chosen.make(l), target: new l.BufferTarget() });
        const conversion = await l.Conversion.init({
          input: input_,
          output: out,
          audio: {
            codec: chosen.codec,
            ...(chosen.codec === "pcm-s16" ? {} : { bitrate: 128000 }),
            ...(outputSampleRate ? { sampleRate: outputSampleRate } : {}),
          },
          video: { discard: true },
        });

        conversion.onProgress = (p: number) => {
          progressBar.style.width = `${Math.round(p * 100)}%`;
        };

        if (!conversion.isValid) throw new Error("invalid");
        if (canceled) {
          void conversion.cancel();
          return;
        }

        running = conversion;
        await conversion.execute();
        if (canceled) return;

        const buffer = out.target.buffer as ArrayBuffer;
        const base = file.name.replace(/\.[^.]+$/, "") || "converted";
        output = { blob: new Blob([buffer], { type: chosen.mime }), name: `${base}.${chosen.ext}` };

        resultText.textContent = `${humanSize(file.size)} → ${humanSize(buffer.byteLength)}`;
        resultEl.classList.remove("hidden");
      } catch (e) {
        // A cancel surfaces as a thrown error, but it is a choice rather than a
        // fault: leave the file selected and say nothing, so pressing Convert
        // again is all it takes.
        if (!canceled) {
          const reason = (e as Error)?.message;
          showError(
            reason === "no-audio"
              ? strings.noAudio
              : reason === "invalid"
                ? strings.badFormat
                : strings.failed,
          );
        }
      } finally {
        running = null;
        cancelBtn.disabled = false;
        progressWrap.classList.add("hidden");
        goBtn.disabled = !file;
      }
    });

    downloadBtn.addEventListener("click", () => {
      if (!output) return;
      const url = URL.createObjectURL(output.blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = output.name;
      a.style.display = "none";
      // Firefox honours the download only for an anchor in the document, and
      // both it and Safari may still be reading the blob after click() returns —
      // revoking on the same tick truncates a large file. The blob itself stays
      // referenced by `output`, so the delay costs no extra memory.
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60_000);
    });

    resetBtn.addEventListener("click", () => {
      file = null;
      output = null;
      input.value = "";
      goBtn.disabled = true;
      resultEl.classList.add("hidden");
      clearMessages();
      nameEl.textContent = strings.pick;
      sizeEl.textContent = strings.hint;
    });
  }
</script>
