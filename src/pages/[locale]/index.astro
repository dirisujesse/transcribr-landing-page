---
import { locales } from "../../paraglide/runtime.js";
import { m } from "../../paraglide/messages.js";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import FeaturesTeaser from "../../components/FeaturesTeaser.astro";
import PrivacyBand from "../../components/PrivacyBand.astro";
import ConverterDemo from "../../components/ConverterDemo.astro";
import Pricing from "../../components/Pricing.astro";
import CTABand from "../../components/CTABand.astro";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---

<Layout
  title={m.seo_home_title()}
  description={m.seo_home_description()}
  locale={locale}
>
  <main>
    <Hero />
    <ConverterDemo />
    <HowItWorks />
    <FeaturesTeaser />
    <PrivacyBand />
    <Pricing />
    <CTABand />
  </main>
</Layout>
