---
import { locales } from "../../paraglide/runtime.js";
import Layout from "../../layouts/Layout.astro";
import { m } from "../../paraglide/messages.js";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const sections = [
  {
    heading: m.privacy_section1_heading(),
    body: m.privacy_section1_text(),
  },
  {
    heading: m.privacy_section2_heading(),
    body: m.privacy_section2_text(),
  },
  {
    heading: m.privacy_section3_heading(),
    body: m.privacy_section3_text(),
  },
  {
    heading: m.privacy_section4_heading(),
    body: m.privacy_section4_text(),
  },
  {
    heading: m.privacy_section5_heading(),
    body: m.privacy_section5_text(),
  },
  {
    heading: m.privacy_section6_heading(),
    body: m.privacy_section6_text(),
  },
  {
    heading: m.privacy_section7_heading(),
    body: m.privacy_section7_text(),
  },
];
---

<Layout title={`${m.privacy_title()} — Transcribr`} description={`${m.privacy_title()} ${m.privacy_for()}: ${m.privacy_section1_heading()}, ${m.privacy_section3_heading()}, ${m.privacy_section5_heading()}.`} locale={locale}>
  <section class="relative overflow-hidden bg-gradient-to-b from-primary-soft/50 to-white pt-28 pb-12 md:pt-32 md:pb-16">
    <div class="container-page">
      <div class="mx-auto max-w-3xl text-center" data-animate>
		<p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">{m.privacy_title()}</p>
		<h1 class="text-4xl font-bold tracking-tight text-foreground md:text-5xl">{m.privacy_title()}</h1>
		<p class="mt-2 text-lg text-muted-foreground">{m.privacy_for()}</p>
		<p class="mt-1 text-sm text-muted-foreground">{m.privacy_last_updated()}</p>
      </div>
    </div>
  </section>

  <section class="section bg-white pt-4 md:pt-8">
    <div class="container-page">
      <div class="prose mx-auto max-w-3xl">
        {sections.map((section) => (
          <div>
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
