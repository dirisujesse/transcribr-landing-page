---
import { locales } from "../../paraglide/runtime.js";
import Layout from "../../layouts/Layout.astro";
import FAQ from "../../components/FAQ.astro";
import { m } from "../../paraglide/messages.js";

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

/**
 * FAQPage structured data, built from the same messages the page renders.
 *
 * This is what lets the answers appear expanded directly in search results,
 * which is the highest-leverage schema available to a site like this. The pairs
 * are enumerated rather than hand-written as objects so that adding an entry to
 * FAQ.astro and forgetting it here stays a one-line mistake instead of a silent
 * omission — q15 was already missing before this list was generated.
 */
const faqPairs: [string, string][] = [
  [m.faq_q1_q(), m.faq_q1_a()],
  [m.faq_q2_q(), m.faq_q2_a()],
  [m.faq_q3_q(), m.faq_q3_a()],
  [m.faq_q4_q(), m.faq_q4_a()],
  [m.faq_q5_q(), m.faq_q5_a()],
  [m.faq_q6_q(), m.faq_q6_a()],
  [m.faq_q7_q(), m.faq_q7_a()],
  [m.faq_q8_q(), m.faq_q8_a()],
  [m.faq_q9_q(), m.faq_q9_a()],
  [m.faq_q10_q(), m.faq_q10_a()],
  [m.faq_q11_q(), m.faq_q11_a()],
  [m.faq_q12_q(), m.faq_q12_a()],
  [m.faq_q13_q(), m.faq_q13_a()],
  [m.faq_q14_q(), m.faq_q14_a()],
  [m.faq_q15_q(), m.faq_q15_a()],
  [m.faq_q16_q(), m.faq_q16_a()],
  [m.faq_q17_q(), m.faq_q17_a()],
  [m.faq_q18_q(), m.faq_q18_a()],
  [m.faq_q19_q(), m.faq_q19_a()],
  [m.faq_q20_q(), m.faq_q20_a()],
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqPairs.map(([question, answer]) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": { "@type": "Answer", "text": answer },
  })),
};
---

<Layout
  title={m.seo_faq_title()}
  description={m.seo_faq_description()}
  locale={locale}
  schema={faqSchema}
>
  <FAQ page />
</Layout>
