---
import { m } from "../paraglide/messages.js";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FeaturesTeaser from "../components/FeaturesTeaser.astro";
import PrivacyBand from "../components/PrivacyBand.astro";
import ConverterDemo from "../components/ConverterDemo.astro";
import Pricing from "../components/Pricing.astro";
import CTABand from "../components/CTABand.astro";
---

<Layout title={m.seo_home_title()}
  description={m.seo_home_description()} locale="en">
  <main>
    <Hero />
    <ConverterDemo />
    <HowItWorks />
    <FeaturesTeaser />
    <PrivacyBand />
    <Pricing />
    <CTABand />
  </main>
</Layout>

<script>
  (function () {
    var supported = ["en", "nl", "de", "es", "hr", "it", "fr"];
    var languages = navigator.languages || [navigator.language || "en"];
    var match = languages
      .map(function (l) {
        return l.split("-")[0];
      })
      .find(function (l) {
        return supported.indexOf(l) !== -1;
      });
    window.location.replace(match ? "/" + match : "/en");
  })();
</script>
