---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

/**
 * The blog index.
 *
 * Not under a locale prefix: posts are written in English, and publishing the
 * same text at seven URLs would divide the search authority the blog exists to
 * build. The locale switcher in the header still works — it moves to the
 * localised version of whatever page you were on before.
 */
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.publishDate - +a.data.publishDate,
);

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

const schema = {
  "@type": "Blog",
  name: "The Transcribr blog",
  url: new URL("/blog", Astro.site).href,
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    datePublished: post.data.publishDate.toISOString(),
    url: new URL(`/blog/${post.id}`, Astro.site).href,
  })),
};
---

<Layout
  title="Blog — Transcribr"
  description="Notes on transcription, privacy and building Transcribr."
  locale="en"
  canonicalPath="/blog"
  schema={schema}
>
  <main class="pt-28 pb-20 md:pt-32">
    <div class="mx-auto max-w-3xl px-6">
      <header class="mb-14">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">
          Blog
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-foreground md:text-5xl">
          Notes from Transcribr
        </h1>
        <p class="mt-5 max-w-2xl text-lg text-muted-foreground">
          What we are building, what we have learned about getting transcription
          right, and how we think about keeping your recordings private.
        </p>
      </header>

      {
        posts.length === 0 ? (
          <p class="text-muted-foreground">Nothing published yet.</p>
        ) : (
          <ul class="space-y-10">
            {posts.map((post) => (
              <li class="border-b border-border pb-10 last:border-b-0">
                <a href={`/blog/${post.id}`} class="group block">
                  <time
                    datetime={post.data.publishDate.toISOString()}
                    class="text-sm text-muted-foreground"
                  >
                    {dateFormat.format(post.data.publishDate)}
                  </time>
                  <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground group-hover:text-primary md:text-3xl">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 text-muted-foreground">{post.data.description}</p>
                  {post.data.tags.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <span class="rounded-full bg-primary-soft px-3 py-1 text-xs font-medium text-primary">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
</Layout>
